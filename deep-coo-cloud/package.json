{
  "name": "deep-coo-cloud",
  "version": "2.4.0",
  "private": true,
  "description": "deep-coo-cloud：Coo 桌宠 × 云端 DSH 人格控制台（本机 DSH Web UI：聊天/总控台/设置/Coo 市场/桌宠 DIY）。总控台含「本机桌宠插件」（前台感知/跨端接话/DIY/看屏幕），看屏幕走本机 Ollama 视觉模型（截图只存本机、只发回环）；Coopanion 扩展收进折叠区。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
