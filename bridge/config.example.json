{
  "serverHost": "<your-server-host-or-ip>",
  "sshUser": "<ssh-user>",
  "sshKey": "<path-to-ssh-private-key>",
  "sshKnownHosts": "<optional-path-to-known_hosts-or-empty>",
  "remoteDshPort": 3080,
  "localTunnelPort": 13380,
  "listenHost": "127.0.0.1",
  "apiPort": 47891,
  "tokenFile": "token.txt",
  "stateFile": "state.json",
  "logFile": "logs/bridge.log",
  "maxLogBytes": 2097152,
  "sessionId": "pet-local",
  "agentPreset": "local-pet",
  "roleCardPath": "<optional-remote-role-card-path-or-empty>",
  "roleCardMode": "once",
  "remoteCredentialsPath": "<remote-path-to-dsh-credentials-yaml>",
  "cwd": "<remote-working-directory>",
  "requestTimeoutMs": 240000,
  "followSnapshotMessages": 10,
  "ensureOnStart": false,
  "followSessionIds": ["pet-local"],
  "messageCacheMax": 1000,
  "historyDefaultLimit": 100,
  "forbiddenSessionIds": [
    "<forbidden-session-id-1>",
    "<forbidden-session-id-2>"
  ],
  "mindDbPath": "<optional-remote-mind-db-path-or-empty>",
  "moodEnabled": true,
  "moodIntervalMs": 60000,
  "moodTimeoutMs": 45000,
  "moodHalfLifeDays": 7,
  "contextInjection": true,
  "contextMaxEvents": 120,
  "contextTtlMs": 3600000,
  "contextInjectMaxChars": 600,
  "contextInjectMaxItems": 6,
  "dashboardServerStatusTtlMs": 30000,
  "dashboardQqTtlMs": 20000,
  "dashboardComponentsTtlMs": 10000,
  "dashboardSshTimeoutMs": 6000,
  "dashboardColdBudgetMs": 1800,
  "qqSocialFile": "<optional-remote-qq-social-file-or-empty>",
  "qqActivityFile": "<optional-remote-qq-activity-log-or-empty>",
  "qqPreviewChats": [
    "<optional-qq-private-chat-key>"
  ],
  "qqPreviewGroups": [
    "<optional-qq-group-key>"
  ],
  "qqPreviewGroup": false,
  "qqPreviewIncludeSelf": true,
  "qqPreviewMaxChars": 60,
  "qqPreviewLineMaxChars": 60,
  "qqPreviewMinTextChars": 4,
  "qqPreviewMaxItems": 4,
  "qqWindowMinutes": 90,
  "dashboardPaths": {
    "observerDir": "../context-observer",
    "syncDir": "../server/awareness",
    "mirrorDir": "../session-mirror"
  }
}
